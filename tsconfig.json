{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2023",
		"types": ["node"]
	},
	"include": ["custom.d.ts", "custom.js", "scripts/*.mjs"]
}
